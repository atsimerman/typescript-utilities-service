# Database Configuration

# Pooled connection string — what the app uses. On Neon this is the hostname
# containing "-pooler".
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Direct, unpooled connection. Used only for restoring dumps and schema work,
# never by the running app. See DEPLOYMENT.md §3.4.
DATABASE_URL_UNPOOLED=

# Better Auth Configuration

# Required. Signs session cookies — a different value invalidates every existing
# session, so use a distinct one per environment.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=your-secret-key-here

# Public origin of the app, e.g. https://example.com
# Leave this unset on Vercel: it is derived from VERCEL_PROJECT_PRODUCTION_URL
# and VERCEL_URL so that preview deployments get their own URL. Setting it in
# every environment makes previews advertise the production domain instead.
BETTER_AUTH_URL=

# Comma-separated extra origins allowed to call the auth endpoints. The app's own
# origin and its Vercel deployment URLs are trusted automatically, so this is
# only for external callers.
BETTER_AUTH_TRUSTED_ORIGINS=
