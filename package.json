{
	"name": "utilities-service",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev db:studio --parallel",
		"lint": "turbo run lint",
		"check-types": "turbo run check-types",
		"clear": "find . -path ./.pnpm-store -prune -o \\( -name node_modules -o -name .next -o -name .turbo -o -name dist -o -name cache \\) -type d -prune -exec rm -rf {} +"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"portless": "^0.15.5",
		"turbo": "^2.10.9",
		"typescript": "5.9.3",
		"ultracite": "^7.10.2"
	},
	"packageManager": "pnpm@10.28.1",
	"engines": {
		"node": ">=22.0.0"
	}
}
